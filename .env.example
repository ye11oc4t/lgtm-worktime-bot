DISCORD_TOKEN=your_discord_bot_token
DATABASE_URL=postgresql://user:password@host:5432/database
TIMEZONE=Asia/Seoul
# 근태 명령과 시간별 알림을 사용할 Discord 텍스트 채널 ID
WORK_CHANNEL_ID=123456789012345678
# /스크럼 작성과 완성 보고서 게시에 사용할 별도 Discord 채널 ID
SCRUM_CHANNEL_ID=234567890123456789
# Slack 앱에서 발급한 Incoming Webhook URL (GitHub에 실제 값을 커밋하지 마세요.)
SLACK_SCRUM_WEBHOOK_URL=
# 테스트 서버에서 명령어를 즉시 동기화하려면 서버 ID를 입력하세요.
GUILD_ID=
LOG_LEVEL=INFO
